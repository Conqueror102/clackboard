{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clackboard",
  "version": "../package.json",
  "identifier": "app.clackboard.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/bundle-mac-helper.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "macOSPrivateApi": true,
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "createUpdaterArtifacts": false,
    "publisher": "Clackboard",
    "copyright": "© 2026 the Clackboard contributors. Based on Hushboard © Tekcify. MIT License.",
    "homepage": "https://github.com/tekcify/hushboard",
    "license": "MIT",
    "category": "Utility",
    "shortDescription": "Mechanical keyboard sounds, and a keyboard lock for cleaning.",
    "longDescription": "Clackboard plays a real mechanical switch sound for every key you press, using Mechvibes sound packs, and can lock the keyboard while you wipe it clean. Built on Hushboard.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-",
      "files": {
        "Helpers/Hushboard Keyboard Helper.app": "../target/mac-helper/Hushboard Keyboard Helper.app"
      },
      "dmg": {
        "windowSize": {
          "width": 600,
          "height": 380
        }
      }
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libayatana-appindicator3-1"
        ]
      },
      "rpm": {
        "depends": [
          "libayatana-appindicator-gtk3"
        ]
      }
    },
    "resources": {
      "resources/packs/": "resources/packs/"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ0MDU1RjkzRjMxMjBEQUYKUldTdkRSTHprMThGMU05U3U2RkRlNkR2bXRYcEhRMkV5akJOWmdJQXBiTDNva1VnUnVtTDM3cHMK",
      "endpoints": [
        "https://github.com/tekcify/hushboard/releases/download/updater/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}